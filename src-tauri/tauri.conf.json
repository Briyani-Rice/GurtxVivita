{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gurtxvivita",
  "version": "0.1.0",
  "identifier": "org.teamgurt",
  "build": {
    "beforeDevCommand": "npm run dev & npx wait-on http://127.0.0.1:5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gurtxvivita",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "acceptFirstMouse": true,
        "hiddenTitle": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
