VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_ADMIN_EMAILS=

# Desktop (Tauri) Google login: Google Cloud console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> type "Desktop app".
# Google requires client_secret on the token exchange for Desktop app clients even
# with PKCE, so BOTH values below are required for desktop Google login. Google
# documents this secret as non-confidential for installed apps.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# URL of the deployed makerAssistant Cloud Function (OpenRouter proxy). Leave blank to
# keep the chatbot fully rule-based. Example:
# https://us-central1-<project-id>.cloudfunctions.net/makerAssistant
VITE_MAKER_ASSISTANT_URL=
