VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_ADMIN_EMAILS=

# Desktop (Tauri) Google login: Google Cloud console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> type "Desktop app".
# A desktop app is a public OAuth client; its client secret is optional.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# URL of the deployed makerAssistant Cloud Function (Groq proxy). Leave blank to
# keep the chatbot fully rule-based. Example:
# https://us-central1-<project-id>.cloudfunctions.net/makerAssistant
VITE_MAKER_ASSISTANT_URL=
