{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "strict": true,
    "skipLibCheck": true,

    "types": ["@figma/plugin-typings"],

    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    "typeRoots": [
      "./node_modules/@types",
      "./node_modules/@figma"
    ]
  },

  "include": [
    "src",
    "plugin",
    "**/*.ts",
    "**/*.tsx",
    "**/*.figma.ts"
  ]
}